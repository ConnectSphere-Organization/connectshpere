# Service identity
SERVICE_NAME=billing-service
PORT=3003
NODE_ENV=development

# Billing-service-owned data and configuration
MONGO_URI=mongodb://localhost:27017/wapi_billing
REDIS_URL=redis://localhost:6379

# Shared platform secrets: use the same values in every service that requires them.
JWT_SECRET=replace-with-generated-jwt-secret
INTERNAL_SERVICE_SECRET=replace-with-generated-internal-service-secret
# Required before saving workspace payment credentials. Use a long, unique secret.
COMMERCE_SETTINGS_ENCRYPTION_KEY=replace-with-a-generated-commerce-encryption-key

# Dependency endpoints and billing-provider credentials
BSP_SERVICE_URL=http://localhost:3004
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
